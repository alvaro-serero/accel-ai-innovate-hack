# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
KEENABLE_API_KEY=
N8N_WEBHOOK_URL=
# Only ONE running instance should poll the shared database:
# false on laptops (except Leo while testing), true on Aiven Runtime.
ENABLE_SCHEDULER=false
